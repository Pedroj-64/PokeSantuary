{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"resolveJsonModule": true,
		"types": ["vite/client"],
		"paths": {
			"@packs/*": ["../../packs/*"]
		}
	},
	"include": ["src", "src/**/*.json"],
